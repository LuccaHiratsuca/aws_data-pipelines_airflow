# Copy to `.env` before running `docker compose up`.
# `.env` is git-ignored -- never commit real credentials.

# --- Docker / Airflow runtime -------------------------------------------------
# On Linux set this to your host UID (`id -u`) so container-written logs stay
# writable. On macOS / Windows the default is fine.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1

# Extra providers installed at container start-up. Required for the Redshift
# COPY (Amazon provider) and the PostgresHook used against Redshift.
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-amazon==8.16.0 apache-airflow-providers-postgres==5.10.0

# --- Bootstrap values consumed by set_connections_and_variables.sh ------------
# The S3 bucket you copied the Udacity datasets into.
S3_BUCKET=your-sparkify-bucket
S3_PREFIX=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

REDSHIFT_HOST=your-workgroup.account.region.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_SCHEMA=dev
REDSHIFT_LOGIN=awsuser
REDSHIFT_PASSWORD=
REDSHIFT_REGION=us-east-1
